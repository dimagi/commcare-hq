                      "properties": {
                        "field_list": {
                          "items": {
                            "properties": {
                              "field_value": {
                                "type": "string"
                              },
                              "properties": {
                                "additionalProperties": {
                                  "type": "string"
                                },
                                "type": "object"
                              }
                            },
                            "type": "object"
                          },
                          "type": "array"
                        }
                      },
                      "type": "object"
                    },
                    "description": "Field values for the row, keyed by field name. Each field holds a field_list of one or more values, each with its own properties (for example a language code).",
                    "type": "object"
                  },
                  "item_attributes": {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "description": "Attribute values for the row, keyed by attribute name.",
                    "type": "object"
                  },
                  "sort_key": {
                    "description": "Order of this row within its lookup table, as defined by the row order in the uploaded Excel file. Not exposed in any user-facing UI.",
                    "type": "integer"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "The created record."
          }
        },
        "summary": "Lookup Table Items",
        "tags": [
          "lookup_table_item"
        ]
      }
    },
    "/a/{domain}/api/lookup_table_item/v1/{pk}/": {
      "delete": {
        "description": "List, create, update or delete the rows (items) of a lookup table in a project space.",
        "operationId": "lookup_table_item_v1_detail_delete",
        "responses": {
          "204": {
            "description": "The record was deleted."
          }
