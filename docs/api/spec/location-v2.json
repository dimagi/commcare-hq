  "paths": {
    "/a/{domain}/api/location/v2/": {
      "get": {
        "description": "List locations in a project space, create locations, or fetch and update a single location. Version 2 returns location data as a nested object and supports filtering by last modified date.\n\nRequires the `edit_locations` permission.",
        "operationId": "location_v2_list_get",
        "parameters": [
          {
            "description": "Maximum number of records to return, capped at 5000. Use 0 to request that maximum.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "type": "integer"
            }
          },
          {
            "description": "Number of records to skip.",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "type": "integer"
            }
          },
          {
            "description": "Response format.",
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "default": "json",
              "enum": [
                "json",
                "xml"
              ],
              "type": "string"
            }
          },
          {
            "description": "Field to sort by. Prefix with \"-\" to reverse.",
            "in": "query",
            "name": "order_by",
            "required": false,
            "schema": {
              "enum": [
                "last_modified",
                "-last_modified"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "domain",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "last_modified__gt",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "last_modified__gte",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "last_modified__lt",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "last_modified__lte",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "name",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "site_code",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
