        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "meta": {
                    "limit": 20,
                    "next": null,
                    "offset": 0,
                    "previous": null,
                    "total_count": 1
                  },
                  "objects": [
                    {
                      "domain": "dimagi-test",
                      "last_modified": "2024-03-11T19:29:16.845849",
                      "latitude": "31.4100000000",
                      "location_data": {
                        "pop": "1001"
                      },
                      "location_id": "68e65fbc2dc840ff8bf03849e57aca88",
                      "location_type_code": "county",
                      "location_type_name": "County",
                      "longitude": null,
                      "name": "Fairfax County",
                      "parent_location_id": "41b0bdfbae20428e9435ae8c3dcd22e7",
                      "site_code": "fairfax_county"
                    }
                  ]
                },
                "schema": {
                  "properties": {
                    "meta": {
                      "$ref": "#/components/schemas/PaginationMeta"
                    },
                    "objects": {
                      "items": {
                        "properties": {
                          "domain": {
                            "description": "Domain (project space) that owns the location.",
                            "type": "string"
                          },
                          "last_modified": {
                            "description": "Date and time the location was last modified.",
                            "format": "date-time",
                            "type": "string"
                          },
                          "latitude": {
                            "description": "Latitude coordinate of the location.",
                            "format": "decimal",
                            "nullable": true,
                            "type": "string"
                          },
                          "location_data": {
                            "additionalProperties": true,
                            "description": "Custom data associated with the location, keyed by field name.",
                            "type": "object"
                          },
                          "location_id": {
                            "description": "UUID of the location.",
                            "type": "string"
                          },
                          "location_type_code": {
                            "description": "Code of the location type of this location.",
                            "type": "string"
                          },
                          "location_type_name": {
                            "description": "Name of the location type of this location. Derived from location_type_code and not itself writable.",
                            "readOnly": true,
                            "type": "string"
                          },
                          "longitude": {
                            "description": "Longitude coordinate of the location.",
                            "format": "decimal",
                            "nullable": true,
                            "type": "string"
                          },
                          "name": {
                            "description": "Name of the location.",
                            "nullable": true,
                            "type": "string"
                          },
                          "parent_location_id": {
                            "description": "Location ID of the parent location, or an empty string if this is a root-level location.",
                            "type": "string"
                          },
                          "site_code": {
                            "description": "Unique (within the domain) code identifying the location, used in case sharing and bulk data.",
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "A page of records."
          }
        },
