                      "type": "string"
                    },
                    "domain": {
                      "description": "Domain (project space) that owns the location.",
                      "type": "string"
                    },
                    "external_id": {
                      "description": "Identifier of the location in an external system, if any.",
                      "nullable": true,
                      "type": "string"
                    },
                    "id": {
                      "description": "Numeric identifier of the location.",
                      "readOnly": true,
                      "type": "integer"
                    },
                    "last_modified": {
                      "description": "Date and time the location was last modified.",
                      "format": "date-time",
                      "type": "string"
                    },
                    "latitude": {
                      "description": "Latitude coordinate of the location.",
                      "format": "decimal",
                      "nullable": true,
                      "type": "string"
                    },
                    "location_data": {
                      "additionalProperties": true,
                      "description": "Custom data associated with the location, keyed by field name.",
                      "type": "object"
                    },
                    "location_id": {
                      "description": "UUID of the location.",
                      "type": "string"
                    },
                    "location_type": {
                      "description": "URI of the location type of this location.",
                      "format": "uri",
                      "type": "string"
                    },
                    "longitude": {
                      "description": "Longitude coordinate of the location.",
                      "format": "decimal",
                      "nullable": true,
                      "type": "string"
                    },
                    "name": {
                      "description": "Name of the location.",
                      "nullable": true,
                      "type": "string"
                    },
                    "parent": {
                      "description": "URI of the parent location, or null if this is a root-level location.",
                      "format": "uri",
                      "nullable": true,
                      "type": "string"
                    },
                    "resource_uri": {
                      "description": "URI of this record in the API.",
                      "readOnly": true,
                      "type": "string"
                    },
                    "site_code": {
                      "description": "Unique (within the domain) code identifying the location, used in case sharing and bulk data.",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The requested record."
          }
        },
        "summary": "Locations",
        "tags": [
          "location"
        ]
      },
      "parameters": [
        {
          "description": "The project space (domain) name.",
          "in": "path",
          "name": "domain",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "description": "Unique identifier of the record.",
          "in": "path",
          "name": "location_id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    },
    {
      "BasicAuth": []
    },
    {
