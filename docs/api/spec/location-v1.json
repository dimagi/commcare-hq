{
  "components": {
    "schemas": {
      "PaginationMeta": {
        "description": "Pagination metadata for a page of records.",
        "properties": {
          "limit": {
            "type": "integer"
          },
          "next": {
            "nullable": true,
            "type": "string"
          },
          "offset": {
            "type": "integer"
          },
          "previous": {
            "nullable": true,
            "type": "string"
          },
          "total_count": {
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "description": "Send the header `Authorization: ApiKey <username>:<api_key>`. Generate an API key from your CommCare HQ account settings.",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      },
      "BasicAuth": {
        "description": "HTTP Basic authentication with a CommCare HQ username and password.",
        "scheme": "basic",
        "type": "http"
      },
      "DigestAuth": {
        "description": "HTTP Digest authentication with a CommCare HQ username and password.",
        "scheme": "digest",
        "type": "http"
      },
      "OAuth2": {
        "description": "OAuth2 with the `access_apis` scope.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "/oauth/authorize/",
            "scopes": {
              "access_apis": "Access the CommCare APIs"
            },
            "tokenUrl": "/oauth/token/"
          }
        },
        "type": "oauth2"
      }
    }
  },
  "info": {
    "description": "CommCare data API.",
    "title": "Locations",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/a/{domain}/api/location/v1/": {
      "get": {
        "description": "List locations in a project space, or fetch a single location by identifier. Locations represent the places, facilities or administrative areas where a project operates, arranged in a hierarchy of location types.\n\nRequires the `edit_locations` permission.",
        "operationId": "location_v1_list_get",
        "parameters": [
          {
            "description": "Maximum number of records to return. Use 0 to request all records.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "type": "integer"
            }
          },
          {
            "description": "Number of records to skip.",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "type": "integer"
            }
          },
          {
            "description": "Response format.",
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "default": "json",
              "enum": [
                "json",
                "xml"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "created_at",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "domain",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "external_id",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "last_modified",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "latitude",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "longitude",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "site_code",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "meta": {
                    "limit": 20,
                    "next": null,
                    "offset": 0,
                    "previous": null,
                    "total_count": 1
                  },
                  "objects": [
                    {
                      "created_at": "2023-05-09T16:10:47.225938",
                      "domain": "demo",
                      "external_id": null,
                      "id": 1,
                      "last_modified": "2023-05-09T16:10:47.225947",
                      "latitude": null,
                      "location_data": {},
                      "location_id": "f373a6837c1243938abfc56618cce88b",
                      "location_type": "https://www.commcarehq.org/a/demo/api/location_type/v1/1/",
                      "longitude": null,
                      "name": "Namibia",
                      "parent": null,
                      "resource_uri": "https://www.commcarehq.org/a/demo/api/location/v1/f373a6837c1243938abfc56618cce88b/",
                      "site_code": "namibia"
                    }
                  ]
                },
                "schema": {
                  "properties": {
                    "meta": {
                      "$ref": "#/components/schemas/PaginationMeta"
                    },
                    "objects": {
                      "items": {
                        "properties": {
                          "created_at": {
                            "description": "Date and time the location was created.",
                            "format": "date-time",
                            "type": "string"
                          },
                          "domain": {
                            "description": "Domain (project space) that owns the location.",
                            "type": "string"
                          },
                          "external_id": {
                            "description": "Identifier of the location in an external system, if any.",
                            "nullable": true,
                            "type": "string"
                          },
                          "id": {
                            "description": "Numeric identifier of the location.",
                            "readOnly": true,
                            "type": "integer"
                          },
                          "last_modified": {
                            "description": "Date and time the location was last modified.",
                            "format": "date-time",
                            "type": "string"
                          },
                          "latitude": {
                            "description": "Latitude coordinate of the location.",
                            "format": "decimal",
                            "nullable": true,
                            "type": "string"
                          },
                          "location_data": {
                            "additionalProperties": true,
                            "description": "Custom data associated with the location, keyed by field name.",
                            "type": "object"
                          },
                          "location_id": {
                            "description": "UUID of the location.",
                            "type": "string"
                          },
                          "location_type": {
                            "description": "URI of the location type of this location.",
                            "format": "uri",
                            "type": "string"
                          },
                          "longitude": {
                            "description": "Longitude coordinate of the location.",
                            "format": "decimal",
                            "nullable": true,
                            "type": "string"
                          },
                          "name": {
                            "description": "Name of the location.",
                            "nullable": true,
                            "type": "string"
                          },
                          "parent": {
                            "description": "URI of the parent location, or null if this is a root-level location.",
                            "format": "uri",
                            "nullable": true,
                            "type": "string"
                          },
                          "resource_uri": {
                            "description": "URI of this record in the API.",
                            "readOnly": true,
                            "type": "string"
                          },
                          "site_code": {
                            "description": "Unique (within the domain) code identifying the location, used in case sharing and bulk data.",
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "A page of records."
          }
        },
        "summary": "Locations",
        "tags": [
          "location"
        ]
      },
      "parameters": [
        {
          "description": "The project space (domain) name.",
          "in": "path",
          "name": "domain",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/a/{domain}/api/location/v1/{location_id}/": {
      "get": {
        "description": "List locations in a project space, or fetch a single location by identifier. Locations represent the places, facilities or administrative areas where a project operates, arranged in a hierarchy of location types.\n\nRequires the `edit_locations` permission.",
        "operationId": "location_v1_detail_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "created_at": {
                      "description": "Date and time the location was created.",
