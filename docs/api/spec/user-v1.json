            "required": false,
            "schema": {
              "default": "json",
              "enum": [
                "json",
                "xml"
              ],
              "type": "string"
            }
          },
          {
            "description": "Group UUID. Returns only mobile workers belonging to that group.",
            "in": "query",
            "name": "group",
            "required": false,
