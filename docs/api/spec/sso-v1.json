{
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApiKeyAuth": {
        "description": "Send the header `Authorization: ApiKey <username>:<api_key>`. Generate an API key from your CommCare HQ account settings.",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      },
      "BasicAuth": {
        "description": "HTTP Basic authentication with a CommCare HQ username and password.",
        "scheme": "basic",
        "type": "http"
      },
      "DigestAuth": {
        "description": "HTTP Digest authentication with a CommCare HQ username and password.",
        "scheme": "digest",
        "type": "http"
      },
      "OAuth2": {
        "description": "OAuth2 with the `access_apis` scope.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "/oauth/authorize/",
            "scopes": {
              "access_apis": "Access the CommCare APIs"
            },
            "tokenUrl": "/oauth/token/"
          }
        },
        "type": "oauth2"
      }
    }
  },
  "info": {
    "description": "CommCare data API.",
    "title": "Sso V1",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/a/{domain}/api/sso/v1/": {
      "parameters": [
        {
          "description": "The project space (domain) name.",
          "in": "path",
          "name": "domain",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "sso_v1_list_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "properties": {
                  "password": {
                    "description": "The user's password.",
                    "format": "password",
                    "type": "string"
                  },
                  "username": {
                    "description": "The user's login name. A name without an \"@\" is qualified with the domain.",
                    "type": "string"
                  }
                },
                "required": [
                  "username",
                  "password"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The authenticated user, serialized as a mobile worker or web user record depending on the account type."
          },
          "400": {
            "description": "username or password was not supplied."
          },
          "403": {
            "description": "The credentials were rejected, or the user is not a member of this project space."
          }
        },
        "security": [],
        "summary": "Sso",
        "tags": [
          "sso"
        ]
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    },
    {
      "BasicAuth": []
    },
    {
      "DigestAuth": []
    },
    {
      "OAuth2": [
        "access_apis"
      ]
    }
  ],
  "servers": [
    {
      "description": "A CommCare HQ instance.",
      "url": "https://{host}",
      "variables": {
        "host": {
          "default": "www.commcarehq.org",
          "description": "Hostname of the CommCare HQ instance."
        }
      }
    }
  ],
  "tags": [
    {
      "name": "sso"
    }
  ]
}
