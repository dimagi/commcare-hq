{
  "components": {
    "schemas": {
      "PaginationMeta": {
        "description": "Pagination metadata for a page of records.",
        "properties": {
          "limit": {
            "type": "integer"
          },
          "next": {
            "nullable": true,
            "type": "string"
          },
          "offset": {
            "type": "integer"
          },
          "previous": {
            "nullable": true,
            "type": "string"
          },
          "total_count": {
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "description": "Send the header `Authorization: ApiKey <username>:<api_key>`. Generate an API key from your CommCare HQ account settings.",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      },
      "BasicAuth": {
        "description": "HTTP Basic authentication with a CommCare HQ username and password.",
        "scheme": "basic",
        "type": "http"
      },
      "DigestAuth": {
        "description": "HTTP Digest authentication with a CommCare HQ username and password.",
        "scheme": "digest",
        "type": "http"
      },
      "OAuth2": {
        "description": "OAuth2 with the `access_apis` scope.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "/oauth/authorize/",
            "scopes": {
              "access_apis": "Access the CommCare APIs"
            },
            "tokenUrl": "/oauth/token/"
          }
        },
        "type": "oauth2"
      }
    }
  },
  "info": {
    "description": "CommCare data API.",
    "title": "Cases",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/a/{domain}/api/case/v2/": {
      "get": {
        "description": "Fetch, create and update cases. GET returns a page of cases matching the given filters, or a single case when a case ID is given. POST with a single JSON object always creates a new case. POST with a list performs a bulk change: each item creates or updates a case according to its own \"create\" field, or is upserted by external_id when \"create\" is omitted. PUT updates the case identified by the case ID or external ID in the URL.",
        "operationId": "case-v2_list_get",
        "parameters": [
          {
            "description": "Return cases with this case name.",
            "in": "query",
            "name": "case_name",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Return cases of this case type.",
            "in": "query",
            "name": "case_type",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Return only closed (true) or only open (false) cases.",
            "in": "query",
            "name": "closed",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Filter by the date the case was closed.",
            "in": "query",
            "name": "date_closed",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Filter by the date the case was opened.",
            "in": "query",
            "name": "date_opened",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Return cases with this external ID.",
            "in": "query",
            "name": "external_id",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Include cases whose case type is deprecated.",
            "in": "query",
            "name": "include_deprecated",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Filter by the date the case was indexed for search.",
            "in": "query",
            "name": "indexed_on",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Return cases indexed by the given case, as indices.<identifier>=<case_id>.",
            "in": "query",
            "name": "indices",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Filter by modification date, as last_modified.gte=<date>.",
            "in": "query",
            "name": "last_modified",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Return cases owned by this user or group ID.",
            "in": "query",
            "name": "owner_id",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Filter by case property, as properties.<name>=<value>.",
            "in": "query",
            "name": "properties",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Filter by server modification date.",
            "in": "query",
            "name": "server_last_modified",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success."
          }
        },
        "summary": "Cases",
        "tags": [
          "case-v2"
        ]
      },
      "parameters": [
        {
          "description": "The project space (domain) name.",
          "in": "path",
          "name": "domain",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "description": "Fetch, create and update cases. GET returns a page of cases matching the given filters, or a single case when a case ID is given. POST with a single JSON object always creates a new case. POST with a list performs a bulk change: each item creates or updates a case according to its own \"create\" field, or is upserted by external_id when \"create\" is omitted. PUT updates the case identified by the case ID or external ID in the URL.",
        "operationId": "case-v2_list_post",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "case_name": "Elizabeth Harmon",
                "case_type": "patient",
                "external_id": "1",
                "indices": {
                  "parent": {
                    "case_id": "eb1a8c23-6d6d-4b61-894c-ae1c437d8dac",
                    "case_type": "household",
                    "relationship": "child"
                  }
                },
                "owner_id": "20cc9dda-b90a-4af3-aa3d-fc67184e73ef",
                "properties": {
                  "dob": "1948-11-02"
                }
              },
              "schema": {
                "oneOf": [
                  {
                    "properties": {
                      "case_name": {
                        "type": "string"
                      },
                      "case_type": {
                        "type": "string"
                      },
                      "close": {
                        "default": false,
                        "type": "boolean"
                      },
                      "external_id": {
                        "type": "string"
                      },
                      "indices": {
                        "additionalProperties": {
                          "properties": {
                            "case_id": {
                              "type": "string"
                            },
                            "case_type": {
                              "type": "string"
                            },
                            "external_id": {
                              "type": "string"
                            },
                            "relationship": {
                              "enum": [
                                "child",
                                "extension"
                              ],
                              "type": "string"
                            },
                            "temporary_id": {
                              "type": "string"
                            }
                          },
                          "type": "object"
                        },
                        "type": "object"
                      },
                      "owner_id": {
                        "type": "string"
                      },
                      "properties": {
                        "additionalProperties": true,
                        "type": "object"
                      },
                      "temporary_id": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "case_name",
                      "case_type",
                      "owner_id"
                    ],
                    "type": "object"
                  },
                  {
                    "items": {
                      "properties": {
                        "case_name": {
                          "type": "string"
                        },
                        "case_type": {
                          "type": "string"
                        },
                        "close": {
                          "default": false,
                          "type": "boolean"
                        },
                        "external_id": {
                          "type": "string"
                        },
                        "indices": {
                          "additionalProperties": {
                            "properties": {
                              "case_id": {
                                "type": "string"
                              },
                              "case_type": {
                                "type": "string"
                              },
                              "external_id": {
                                "type": "string"
                              },
                              "relationship": {
                                "enum": [
                                  "child",
                                  "extension"
                                ],
                                "type": "string"
                              },
                              "temporary_id": {
                                "type": "string"
                              }
                            },
                            "type": "object"
                          },
                          "type": "object"
                        },
                        "owner_id": {
                          "type": "string"
                        },
                        "properties": {
                          "additionalProperties": true,
                          "type": "object"
                        },
                        "temporary_id": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "case_name",
                        "case_type",
                        "owner_id"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  }
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Success."
          }
        },
        "summary": "Cases",
        "tags": [
          "case-v2"
        ]
      },
      "put": {
        "description": "Fetch, create and update cases. GET returns a page of cases matching the given filters, or a single case when a case ID is given. POST with a single JSON object always creates a new case. POST with a list performs a bulk change: each item creates or updates a case according to its own \"create\" field, or is upserted by external_id when \"create\" is omitted. PUT updates the case identified by the case ID or external ID in the URL.",
        "operationId": "case-v2_list_put",
        "responses": {
          "200": {
            "description": "Success."
          }
        },
        "summary": "Cases",
        "tags": [
          "case-v2"
        ]
      }
    },
    "/a/{domain}/api/case/v2/{case_id}/": {
      "get": {
        "description": "Fetch, create and update cases. GET returns a page of cases matching the given filters, or a single case when a case ID is given. POST with a single JSON object always creates a new case. POST with a list performs a bulk change: each item creates or updates a case according to its own \"create\" field, or is upserted by external_id when \"create\" is omitted. PUT updates the case identified by the case ID or external ID in the URL.",
        "operationId": "case-v2_detail_get",
        "responses": {
          "200": {
            "description": "Success."
          }
        },
        "summary": "Cases",
        "tags": [
          "case-v2"
        ]
      },
      "parameters": [
        {
          "description": "The project space (domain) name.",
          "in": "path",
          "name": "domain",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "in": "path",
          "name": "case_id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "put": {
        "description": "Fetch, create and update cases. GET returns a page of cases matching the given filters, or a single case when a case ID is given. POST with a single JSON object always creates a new case. POST with a list performs a bulk change: each item creates or updates a case according to its own \"create\" field, or is upserted by external_id when \"create\" is omitted. PUT updates the case identified by the case ID or external ID in the URL.",
        "operationId": "case-v2_detail_put",
        "responses": {
          "200": {
            "description": "Success."
