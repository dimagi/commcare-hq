{
  "components": {
    "schemas": {
      "PaginationMeta": {
        "description": "Pagination metadata for a page of records.",
        "properties": {
          "limit": {
            "type": "integer"
          },
          "next": {
            "nullable": true,
            "type": "string"
          },
          "offset": {
            "type": "integer"
          },
          "previous": {
            "nullable": true,
            "type": "string"
          },
          "total_count": {
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "description": "Send the header `Authorization: ApiKey <username>:<api_key>`. Generate an API key from your CommCare HQ account settings.",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      },
      "BasicAuth": {
        "description": "HTTP Basic authentication with a CommCare HQ username and password.",
        "scheme": "basic",
        "type": "http"
      },
      "DigestAuth": {
        "description": "HTTP Digest authentication with a CommCare HQ username and password.",
        "scheme": "digest",
        "type": "http"
      },
      "OAuth2": {
        "description": "OAuth2 with the `access_apis` scope.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "/oauth/authorize/",
            "scopes": {
              "access_apis": "Access the CommCare APIs"
            },
            "tokenUrl": "/oauth/token/"
          }
        },
        "type": "oauth2"
      }
    }
  },
  "info": {
    "description": "CommCare data API.",
    "title": "Form V1",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/a/{domain}/api/form/v1/": {
      "get": {
        "description": "Requires the `edit_data` permission.",
        "operationId": "form_v1_list_get",
        "parameters": [
          {
            "description": "Maximum number of records to return. Use 0 to request all records.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "type": "integer"
            }
          },
          {
            "description": "Number of records to skip.",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "type": "integer"
            }
          },
          {
            "description": "Response format.",
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "default": "json",
              "enum": [
                "json",
                "xml"
              ],
              "type": "string"
            }
          },
          {
            "description": "Field to sort by. Prefix with \"-\" to reverse.",
            "in": "query",
            "name": "order_by",
            "required": false,
            "schema": {
              "enum": [
                "received_on",
                "server_modified_on",
                "indexed_on",
                "-received_on",
                "-server_modified_on",
                "-indexed_on"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "meta": {
                      "$ref": "#/components/schemas/PaginationMeta"
                    },
                    "objects": {
                      "items": {
                        "properties": {
                          "app_id": {
                            "nullable": true,
                            "type": "string"
                          },
                          "archived": {
                            "readOnly": true,
                            "type": "string"
                          },
                          "attachments": {
                            "additionalProperties": true,
                            "nullable": true,
                            "readOnly": true,
                            "type": "object"
                          },
                          "build_id": {
                            "nullable": true,
                            "type": "string"
                          },
                          "cases": {
                            "type": "string"
                          },
                          "domain": {
                            "type": "string"
                          },
                          "edited_by_user_id": {
                            "nullable": true,
                            "readOnly": true,
                            "type": "string"
                          },
                          "edited_on": {
                            "nullable": true,
                            "type": "string"
                          },
                          "form": {
                            "additionalProperties": true,
                            "type": "object"
                          },
                          "id": {
                            "readOnly": true,
                            "type": "string"
                          },
                          "indexed_on": {
                            "type": "string"
                          },
                          "initial_processing_complete": {
                            "nullable": true,
                            "type": "boolean"
                          },
                          "is_phone_submission": {
                            "readOnly": true,
                            "type": "boolean"
                          },
                          "metadata": {
                            "additionalProperties": true,
                            "nullable": true,
                            "type": "object"
                          },
                          "problem": {
                            "nullable": true,
                            "type": "string"
                          },
                          "received_on": {
                            "type": "string"
                          },
                          "resource_uri": {
                            "readOnly": true,
                            "type": "string"
                          },
                          "server_modified_on": {
                            "type": "string"
                          },
                          "submit_ip": {
                            "nullable": true,
                            "type": "string"
                          },
                          "type": {
                            "type": "string"
                          },
                          "uiversion": {
                            "nullable": true,
                            "type": "string"
                          },
                          "version": {
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "A page of records."
          }
        },
        "summary": "Form",
        "tags": [
          "form"
        ]
      },
      "parameters": [
        {
          "description": "The project space (domain) name.",
          "in": "path",
          "name": "domain",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/a/{domain}/api/form/v1/{pk}/": {
      "get": {
        "description": "Requires the `edit_data` permission.",
        "operationId": "form_v1_detail_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "app_id": {
                      "nullable": true,
                      "type": "string"
                    },
                    "archived": {
                      "readOnly": true,
                      "type": "string"
                    },
                    "attachments": {
                      "additionalProperties": true,
                      "nullable": true,
                      "readOnly": true,
                      "type": "object"
                    },
                    "build_id": {
                      "nullable": true,
                      "type": "string"
                    },
                    "cases": {
                      "type": "string"
                    },
                    "domain": {
                      "type": "string"
                    },
                    "edited_by_user_id": {
                      "nullable": true,
                      "readOnly": true,
                      "type": "string"
                    },
                    "edited_on": {
                      "nullable": true,
                      "type": "string"
                    },
                    "form": {
                      "additionalProperties": true,
                      "type": "object"
                    },
                    "id": {
                      "readOnly": true,
                      "type": "string"
                    },
                    "indexed_on": {
                      "type": "string"
                    },
                    "initial_processing_complete": {
                      "nullable": true,
                      "type": "boolean"
                    },
                    "is_phone_submission": {
                      "readOnly": true,
                      "type": "boolean"
                    },
                    "metadata": {
                      "additionalProperties": true,
                      "nullable": true,
                      "type": "object"
                    },
                    "problem": {
                      "nullable": true,
                      "type": "string"
                    },
                    "received_on": {
                      "type": "string"
                    },
                    "resource_uri": {
                      "readOnly": true,
                      "type": "string"
                    },
                    "server_modified_on": {
                      "type": "string"
                    },
                    "submit_ip": {
                      "nullable": true,
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    },
                    "uiversion": {
                      "nullable": true,
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The requested record."
          }
        },
        "summary": "Form",
        "tags": [
          "form"
        ]
      },
      "parameters": [
        {
          "description": "The project space (domain) name.",
          "in": "path",
          "name": "domain",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "description": "Unique identifier of the record.",
          "in": "path",
          "name": "pk",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    },
    {
      "BasicAuth": []
    },
    {
      "DigestAuth": []
    },
    {
      "OAuth2": [
        "access_apis"
      ]
    }
  ],
  "servers": [
    {
      "description": "A CommCare HQ instance.",
      "url": "https://{host}",
      "variables": {
        "host": {
          "default": "www.commcarehq.org",
          "description": "Hostname of the CommCare HQ instance."
        }
      }
    }
  ]
}
