  "info": {
    "description": "CommCare data API.",
    "title": "Forms",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/a/{domain}/api/form/v1/": {
      "get": {
        "description": "List form submissions in a project space, or fetch a single form by identifier. Forms are individual data submissions made from CommCare mobile or web apps.\n\nRequires the `edit_data` permission.",
        "operationId": "form_v1_list_get",
        "parameters": [
          {
            "description": "Maximum number of records to return, capped at 1000. Use 0 to request that maximum.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "type": "integer"
            }
          },
          {
            "description": "Number of records to skip.",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "type": "integer"
            }
          },
          {
            "description": "Response format.",
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "default": "json",
              "enum": [
                "json",
                "xml"
              ],
              "type": "string"
            }
          },
          {
            "description": "Field to sort by. Prefix with \"-\" to reverse.",
            "in": "query",
            "name": "order_by",
            "required": false,
            "schema": {
              "enum": [
                "received_on",
                "server_modified_on",
                "indexed_on",
                "-received_on",
                "-server_modified_on",
                "-indexed_on"
              ],
              "type": "string"
            }
          },
          {
            "description": "Form XML namespace.",
            "in": "query",
            "name": "xmlns",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Limit to forms submitted from this application.",
            "in": "query",
            "name": "app_id",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Only return forms received on or after this date (and time).",
            "in": "query",
            "name": "received_on_start",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "Only return forms received on or before this date (and time).",
            "in": "query",
            "name": "received_on_end",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "Only return forms indexed into CommCare HQ on or after this date (and time). Recommended for pagination, as it handles edge cases better than received_on.",
            "in": "query",
            "name": "indexed_on_start",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "Only return forms indexed into CommCare HQ on or before this date (and time).",
            "in": "query",
            "name": "indexed_on_end",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "Not supported. This filter is accepted but never matches, so a request using it always returns zero results.",
            "in": "query",
            "name": "appVersion",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "When true, archived forms are included in the response.",
            "in": "query",
            "name": "include_archived",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "Only return forms that updated the case with this UUID.",
            "in": "query",
            "name": "case_id",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "When true, include the full case objects referenced by this form in the \"cases\" field.",
            "in": "query",
            "name": "cases__full",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "meta": {
